{
  "name": "dsh-fishpai",
  "version": "1.1.0",
  "description": "DeepSeek Harness plugin: 鱼排 FishPai — a WeChat Official Account typesetting workbench in the DSH right sidebar, with block-level diffs and annotations a model can read. Rendering core derived from the MIT mopai-markdown.",
  "type": "module",
  "license": "MIT",
  "author": "OMSociety (https://github.com/OMSociety)",
  "homepage": "https://github.com/OMSociety/dsh-fishpai#readme",
  "bugs": "https://github.com/OMSociety/dsh-fishpai/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/dsh-fishpai.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "markdown",
    "typesetting",
    "sidebar",
    "skill"
  ],
  "main": "./plugin/index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "icon.svg",
    "locale/*.json",
    "plugin",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:golden:regen": "node scripts/regen-golden.mjs",
    "check:build": "node scripts/build-client.mjs && git diff --exit-code -- lib/"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
