{
  "name": "dsh-fishpai",
  "version": "2.0.2",
  "description": "DeepSeek Harness plugin: 鱼排 FishPai — WeChat Official Account typesetting and collaborative editing with a professional canvas, interactive components, and clipboard-ready output.",
  "type": "module",
  "license": "MIT",
  "author": "OMSociety (https://github.com/OMSociety)",
  "homepage": "https://github.com/OMSociety/dsh-fishpai#readme",
  "bugs": "https://github.com/OMSociety/dsh-fishpai/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/dsh-fishpai.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "markdown",
    "typesetting",
    "sidebar",
    "skill"
  ],
  "main": "./plugin/index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "icon.svg",
    "locale/*.json",
    "plugin",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20",
    "dsh": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:golden:regen": "node scripts/regen-golden.mjs",
    "check:build": "node scripts/build-client.mjs && git diff --exit-code -- lib/",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "cheerio": "1.0.0"
  }
}
